# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)
# 비워 두면 괄호 안의 기본값으로 동작해요.

# DB 주소. 비워 두면 backend 폴더에 anshim-dev.db (SQLite 파일)를 만들어서 씀 → PC에서 바로 실행해 보기용
# PostgreSQL 예: postgresql://사용자:비밀번호@호스트:5432/DB이름
DATABASE_URL=

# 로그인 토큰 서명용 비밀키. 아무도 모르는 긴 문자열로 (비워 두면 서버를 켤 때마다 새로 만들어서, 재시작하면 다시 로그인해야 함)
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 이 서버를 불러도 되는 프론트 주소 (쉼표로 여러 개). 기본: http://localhost:5173
# 예: http://localhost:5173,https://anshim-web.vercel.app
CORS_ORIGINS=

# 로그인 유지 시간(시간), 일반 위치공유 링크 유효시간(분). 기본: 12, 60
TOKEN_EXPIRE_HOURS=
SHARE_EXPIRE_MIN=
